# 复制为 .env.macos，填写目标 Mac 的绝对路径。此文件由 Bash 读取。
# conda info --base 的输出
CONDA_BASE=""
# conda activate nonebot 后 echo "$CONDA_PREFIX" 的输出
CONDA_ENV_PATH=""

# meme-generator-rs 的模板图片、字体、配置和临时文件根目录。
# 放在与其他 NapCat/NoneBot 运行资源相同的 Documents/napcat 下。
export MEME_HOME="$HOME/Documents/napcat/meme_generator"
