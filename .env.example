# NoneBot / OneBot
HOST=0.0.0.0
PORT=2333
ONEBOT_ACCESS_TOKEN=
NICKNAME=["小P"]

# multi_llm_chat
LLM_CHAT_WHITELIST=["群号"]
LLM_CHAT_MODEL="mimo-v2.5"
LLM_CHAT_DEEPSEEK_API_KEY=
LLM_CHAT_XIAOMI_MIMO_API_KEY=
LLM_CHAT_TEMPERATURE=0.7
LLM_CHAT_MAX_TOKENS=4096
LLM_CHAT_REQUEST_TIMEOUT=60
# 未配置时遵循模型默认值：mimo-v2.5 开启，DeepSeek 关闭
# LLM_CHAT_IMAGE_UNDERSTANDING=true

LLM_CHAT_STATE_DIR="state"
LLM_CHAT_IDENTITY_CONFIG_FILE="identity_config.json"
LLM_CHAT_DAILY_DIGEST_CONFIG_FILE="daily_digest_config.json"
LLM_CHAT_RAW_REQUEST_LOG_DIR="llm_request_logs"
LLM_CHAT_RAW_REQUEST_RETENTION_DAYS=7

LLM_CHAT_TIMEOUT=10
LLM_CHAT_REPLY_GRACE_SECONDS=0.5
LLM_CHAT_CONTEXT_CHAR_BUDGET=24000
LLM_CHAT_RECENT_EVENT_MIN_COUNT=8
LLM_CHAT_CONVERSATION_MAX_EVENTS=80
LLM_CHAT_SUMMARY_MAX_CHARS=6000
LLM_CHAT_MEMORY_MAX_FACTS=64
LLM_CHAT_MEMORY_MAX_ALIASES_PER_MEMBER=8
LLM_CHAT_ROSTER_REFRESH_SECONDS=21600

LLM_CHAT_MAX_TOOL_STEPS=4
LLM_CHAT_TOOL_TIMEOUT_SECONDS=30
LLM_CHAT_TOOL_OUTPUT_MAX_CHARS=12000
LLM_CHAT_CUSTOM_TOOLS_MODULE=""

LLM_CHAT_CLI_IMAGE="peteralbus-nonebot-tool-runner:latest"
LLM_CHAT_CLI_TIMEOUT_SECONDS=20
LLM_CHAT_CLI_OUTPUT_MAX_CHARS=12000
LLM_CHAT_CLI_WORKSPACE_DIR="tool_workspaces"
