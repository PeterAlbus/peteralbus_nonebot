# Create a fixed token with: openssl rand -hex 32
OPS_API_TOKEN=
OPS_API_HOST=127.0.0.1
OPS_API_PORT=8765

OPS_NONEBOT_LABEL=com.peteralbus.nonebot
OPS_NONEBOT_ENV_FILE=.env
OPS_NONEBOT_LOG_FILE="$HOME/Documents/napcat/service_logs/nonebot.stdout.log"

# Set the bot account number. NapCat restart targets only this -q account.
OPS_NAPCAT_ACCOUNT=
OPS_NAPCAT_QQ_APP=/Applications/QQ.app
OPS_NAPCAT_QQ_BINARY=/Applications/QQ.app/Contents/MacOS/QQ
OPS_NAPCAT_STDOUT_LOG="$HOME/Documents/napcat/service_logs/napcat.stdout.log"
OPS_NAPCAT_WEBUI_PORT=6099
OPS_NAPCAT_HTTP_PORT=3001

OPS_SHUTDOWN_TIMEOUT_SECONDS=20
OPS_STARTUP_TIMEOUT_SECONDS=35
OPS_COMMAND_TIMEOUT_SECONDS=5
